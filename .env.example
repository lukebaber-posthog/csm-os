# Supabase project that stores board state and the outreach log.
# The publishable key is safe to ship in the renderer; no revenue data is
# stored in Supabase (ARR is fetched live from PostHog and cached on-device).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Optional PostHog overrides, read by the main process.
# POSTHOG_HOST=https://us.posthog.com
# POSTHOG_PROJECT_ID=2

# logo.dev publishable key, used by the renderer to build account logo URLs.
# Publishable by design (it is safe in the client); without it cards fall back
# to monograms. Get one at https://logo.dev.
VITE_PUBLIC_LOGO_DEV_API=pk_TVC5v6y6R5W3CZ8RfHjdQA
